# AI chat (Gemini). Keep your real .env private: never publish it or zip it for others.
# Put a file named .env next to this one (project root) with your key:
GEMINI_API_KEY=
# Best quality first; falls back automatically when its free daily/minute limit is reached.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACKS=gemini-3.5-flash-lite
